{
  "name": "zarrita-rs",
  "projectType": "library",
  "tags": ["type:lib", "lang:typescript"],
  "targets": {
    "build:wasm": {
      "command": "bun run build:wasm",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{projectRoot}/crates/**/*",
        "{projectRoot}/scripts/build-wasm.sh"
      ],
      "outputs": [
        "{projectRoot}/src/wasm/zarrita.wasm",
        "{projectRoot}/src/wasm/zarrita.wasm.inputs"
      ]
    },
    "build": {
      "command": "bun run build",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": [
        "typescript",
        "{projectRoot}/src/**/*",
        "{projectRoot}/scripts/**/*"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "command": "bunx vitest run && bun run test:dist",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["build"],
      "inputs": [
        "typescript",
        "{projectRoot}/__tests__/**/*",
        "{projectRoot}/fixtures/**/*"
      ]
    },
    "test:rust": {
      "command": "cargo test -p zarrita -p zarrita-storage -p zarrita-rs",
      "inputs": [
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{projectRoot}/crates/**/*",
        "{projectRoot}/scripts/build-wasm.sh",
        "{projectRoot}/fixtures/**/*"
      ]
    },
    "lint:rust": {
      "command": "cargo fmt --check -p zarrita -p zarrita-storage -p zarrita-rs && cargo clippy -p zarrita -p zarrita-storage -p zarrita-rs -- -D warnings",
      "inputs": [
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/rust-toolchain.toml",
        "{projectRoot}/crates/**/*"
      ]
    },
    "typecheck": {
      "command": "bunx tsc --noEmit",
      "options": {
        "cwd": "{projectRoot}"
      },
      "inputs": ["typescript"]
    },
    "lint": {
      "command": "bunx biome check {projectRoot} && node {projectRoot}/scripts/wasm-fingerprint.mjs --check",
      "inputs": [
        "lintable",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{projectRoot}/crates/**/*",
        "{projectRoot}/scripts/build-wasm.sh",
        "{projectRoot}/src/wasm/zarrita.wasm",
        "{projectRoot}/src/wasm/zarrita.wasm.inputs"
      ]
    },
    "format": {
      "command": "bunx biome format {projectRoot} --write",
      "inputs": ["lintable"]
    }
  }
}
